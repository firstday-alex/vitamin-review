

<div class="blog-post-content rte">
  <rte-formatter>
    {{ article.content }}
  </rte-formatter>
</div>

{% stylesheet %}
  .blog-post-content {
    max-width: var(--normal-content-width);
    margin: 0 auto;
  }

  /* ---------------------------------------------------------------------------
     Article body typography.

     Colours and sizes come from the "Article typography" theme settings, via
     the custom properties declared in snippets/theme-styles-variables.liquid.
     They can't be read here directly: Shopify does not run stylesheet blocks
     through Liquid, so a settings lookup in this file would emit as plain text.

     Selectors are scoped `.blog-post-content.rte` (two classes) so they outrank
     the bare `h2` / `p` rules in base.css without !important, and leave every
     other rich-text area on the theme's own type scale.
     --------------------------------------------------------------------------- */
  .blog-post-content.rte {
    color: var(--article-text-color, #4b3b7a);
    font-family: 'sofia-pro', sans-serif;
    font-size: var(--article-body-size, 18px);
    line-height: var(--article-body-line-height, 1.7);
  }

  .blog-post-content.rte :is(p, ul, ol, blockquote) {
    color: var(--article-text-color, #4b3b7a);
    font-size: var(--article-body-size, 18px);
    line-height: var(--article-body-line-height, 1.7);
  }

  .blog-post-content.rte p {
    margin-block: 0 1.1em;
  }

  .blog-post-content.rte :is(h2, h3, h4) {
    color: var(--article-heading-color, #3b1e6b);
    font-family: 'sofia-pro', sans-serif;
    font-weight: 700;
    letter-spacing: -0.01em;
    /* Headings belong to the copy that follows, so the space above is much
       larger than the space below. */
    margin-block: 1.6em 0.6em;
    text-wrap: pretty;
  }

  .blog-post-content.rte h2 {
    font-size: var(--article-h2-size-mobile, 30px);
    line-height: 1.15;
  }

  .blog-post-content.rte h3 {
    font-size: var(--article-h3-size, 24px);
    line-height: 1.25;
  }

  /* Nothing should push the very first element away from the section above. */
  .blog-post-content.rte > rte-formatter > :first-child,
  .blog-post-content.rte > :first-child {
    margin-block-start: 0;
  }

  .blog-post-content.rte :is(strong, b) {
    color: var(--article-strong-color, #3b1e6b);
    font-weight: 700;
  }

  .blog-post-content.rte a:not(.button) {
    color: var(--article-link-color, #486ced);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.15em;
  }

  .blog-post-content.rte a:not(.button):hover {
    color: var(--article-link-hover-color, #2f49b8);
  }

  .blog-post-content.rte li {
    margin-block-end: 0.5em;
  }

  /* Images run the full width of the copy and get their own breathing room, as
     in the design. Height is left to the intrinsic ratio. */
  .blog-post-content.rte img {
    display: block;
    /* max-width, not width: a narrow image should stay its own size and centre,
       rather than being upscaled to the column and going soft. */
    max-width: 100%;
    height: auto;
    margin-block: 1.8em;
    margin-inline: auto;
  }

  /* Table cells size their own images. */
  .blog-post-content.rte :is(td, th) img {
    margin-block: 0;
  }

  @media screen and (min-width: 750px) {
    .blog-post-content.rte h2 {
      font-size: var(--article-h2-size, 36px);
    }
  }

  /* ---------------------------------------------------------------------------
     Comparison tables inside article bodies.

     Every selector is scoped with `.blog-post-content.rte` (two classes) so it
     outranks the generic `.rte table` rules in base.css without !important, and
     so product descriptions and pages keep the default table styling.

     The rounded frame lives on `.rte-table-wrapper`, the scroll container that
     assets/rte-formatter.js puts around each table — a table with
     border-collapse can't clip its own corners.
     --------------------------------------------------------------------------- */
  .blog-post-content.rte {
    --article-table-frame: #3b1e5f;
    --article-table-head-bg: #efebfb;
    --article-table-label-bg: #efebfb;
    --article-table-stripe: #e9f2fb;
    --article-table-text: #2e1a47;
    --article-table-rule: #e2daf5;
    --article-table-radius: 18px;
  }

  .blog-post-content.rte .rte-table-wrapper {
    /* overflow-y must not be `visible`, or the radius won't clip the corners. */
    overflow-x: auto;
    overflow-y: hidden;
    border: 2px solid var(--article-table-frame);
    border-radius: var(--article-table-radius);
    background: #ffffff;
    overscroll-behavior-x: contain;
    scrollbar-width: thin;
  }

  .blog-post-content.rte table {
    /* base.css pins tables to `fixed`, which splits columns evenly; `auto` lets
       the label column stay narrow and the data columns take the room. */
    table-layout: auto;
    min-width: 34rem;
    border: 0;
    color: var(--article-table-text);
    font-family: 'sofia-pro', sans-serif;
    line-height: 1.4;
  }

  /* Row rules are drawn per cell below, so drop the theme's row borders. */
  .blog-post-content.rte table tr {
    border: 0;
  }

  /* Logical properties, to match (and outrank) the padding longhands base.css
     and component-rte.css set on these cells. */
  .blog-post-content.rte table :is(th, td) {
    padding-block: 1rem;
    padding-inline: 1.25rem;
    border: 0;
    text-align: start;
    vertical-align: middle;
  }

  /* Header row — a real <thead>, or a first row that has no <td> in it, which is
     what the rich-text editor produces when a header row isn't marked up. */
  .blog-post-content.rte table :is(thead, tr:not(:has(td))) :is(th, td) {
    background: var(--article-table-head-bg);
    border-bottom: 2px solid var(--article-table-frame);
    font-size: 0.875em;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-align: center;
    text-transform: uppercase;
  }

  /* Label column: bold, tinted, and pinned open while the table scrolls
     sideways on narrow screens. The divider is an inset shadow rather than a
     border because borders on sticky cells drop out under border-collapse. */
  .blog-post-content.rte table tr > :first-child {
    position: sticky;
    left: 0;
    z-index: 1;
    background: var(--article-table-label-bg);
    box-shadow: inset -2px 0 0 var(--article-table-frame);
    font-weight: 700;
    text-align: start;
  }

  /* Zebra striping on the data columns, counted so the first data row is always
     unstriped whichever way the header is marked up.

     Note: `:has()` can't be nested inside `:has()` — it makes the selector
     invalid, which silently drops the whole rule, striping included. Both
     branches below detect the header row without nesting.  */

  /* Header row sits in the same <tbody> (no <thead>): skip it, then alternate. */
  .blog-post-content.rte table tr:not(:has(td)) ~ tr:nth-child(odd) > :not(:first-child),
  /* Header in <thead>, or no header at all: alternate from the top of the body.
     Rows already covered by the branch above are excluded. */
  .blog-post-content.rte table tbody tr:nth-child(even):not(tr:not(:has(td)) ~ *) > :not(:first-child) {
    background: var(--article-table-stripe);
  }

  /* Hairlines between adjacent data rows only — a row right below a header row
     must not stack a hairline against the header's 2px rule. */
  .blog-post-content.rte table tr:has(td) + tr:has(td) > :is(th, td) {
    border-top: 1px solid var(--article-table-rule);
  }

  @media screen and (max-width: 749px) {
    .blog-post-content.rte {
      --article-table-radius: 14px;
    }

    .blog-post-content.rte table :is(th, td) {
      padding-block: 0.75rem;
      padding-inline: 0.875rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.content",
  "settings": [],
  "presets": [
    {
      "name": "t:names.content"
    }
  ]
}
{% endschema %}
