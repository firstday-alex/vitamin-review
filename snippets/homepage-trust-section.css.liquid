<style>
{% comment %}
  Homepage Trust Section - CSS Styles
  Carousel with trust items (testimonials, images, videos) and statistics cards
{% endcomment %}

/* ==========================================================================
   CSS Variables (passed from section)
   ========================================================================== */
.homepage-trust-section-{{ section_id }} {
  --trust-bg-color: {{ background_color }};
  --trust-text-color: {{ text_color }};
  --trust-card-bg: {{ card_background }};
  --trust-media-bg: {{ media_card_background }};
}

/* ==========================================================================
   Base Section Styles
   ========================================================================== */
.homepage-trust-section-{{ section_id }} {
  background-color: var(--trust-bg-color);
  color: var(--trust-text-color);
  padding: 40px 10px;
}

.homepage-trust-section__container-{{ section_id }} {
  max-width: 1280px;
  margin: 0 auto;
}

/* ==========================================================================
   Section Title
   ========================================================================== */
.homepage-trust-section__title-{{ section_id }} {
  font-family: 'sofia-pro', sans-serif;
  font-weight: 400;
  font-size: 38px;
  line-height: 1.3;
  text-align: center;
  margin: 0 0 32px 0;
  color: var(--trust-text-color);
}

.homepage-trust-section__title-{{ section_id }} strong {
  font-weight: 700;
}

/* ==========================================================================
   Carousel Container
   ========================================================================== */
.homepage-trust-section__carousel-{{ section_id }} {
  position: relative;
  margin-bottom: 48px;
}

.homepage-trust-section__carousel-viewport-{{ section_id }} {
  overflow: hidden;
}

.homepage-trust-section__carousel-track-{{ section_id }} {
  display: flex;
  gap: 16px;
  padding: 4px 0;
  /* Transform-based carousel on desktop - no scroll */
  transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

/* ==========================================================================
   Trust Item Cards (Base)
   ========================================================================== */
.homepage-trust-section__item-{{ section_id }} {
  flex: 0 0 280px;
  width: 280px;
  height: 400px;
  border-radius: 8px;
  overflow: hidden;
  position: relative;
}

/* Image Item */
.homepage-trust-section__item-{{ section_id }}--image {
  background-color: #f5f5f5;
}

.homepage-trust-section__item-{{ section_id }}--image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.homepage-trust-section__item-{{ section_id }}--image.has-overlay::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.3);
  pointer-events: none;
}

/* Expert Quote Item */
.homepage-trust-section__item-{{ section_id }}--expert {
  background-color: var(--trust-card-bg);
  padding: 24px;
  display: flex;
  flex-direction: column;
}

.homepage-trust-section__expert-image-{{ section_id }} {
  width: 80px;
  height: 80px;
  border-radius: 50%;
  overflow: hidden;
  margin-bottom: 16px;
  flex-shrink: 0;
}

.homepage-trust-section__expert-image-{{ section_id }} img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.homepage-trust-section__expert-quote-{{ section_id }} {
  font-family: 'sofia-pro', sans-serif;
  font-weight: 400;
  font-size: 16px;
  line-height: 1.5;
  margin: 0 0 auto 0;
  color: var(--trust-text-color);
}

.homepage-trust-section__expert-info-{{ section_id }} {
  margin-top: 16px;
}

.homepage-trust-section__expert-name-{{ section_id }} {
  font-family: 'sofia-pro', sans-serif;
  font-weight: 700;
  font-size: 16px;
  line-height: 1.3;
  margin: 0;
  color: var(--trust-text-color);
}

.homepage-trust-section__expert-credentials-{{ section_id }} {
  font-family: 'sofia-pro', sans-serif;
  font-weight: 400;
  font-size: 14px;
  line-height: 1.4;
  margin: 4px 0 0 0;
  color: var(--trust-text-color);
  opacity: 0.8;
}

/* Video Item */
.homepage-trust-section__item-{{ section_id }}--video {
  background-color: #000;
  cursor: pointer;
}

.homepage-trust-section__item-{{ section_id }}--video img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.homepage-trust-section__video-overlay-{{ section_id }} {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.homepage-trust-section__play-button-{{ section_id }} {
  width: 64px;
  height: 64px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.95);
  border: none;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.2s ease;
}

.homepage-trust-section__play-button-{{ section_id }}:hover {
  transform: scale(1.1);
}

.homepage-trust-section__play-button-{{ section_id }} svg {
  width: 24px;
  height: 24px;
  fill: var(--trust-text-color);
  {% comment %}margin-left: 4px;{% endcomment %}
}

/* Video Playing State — once the card has been clicked, the inline <video>
   or <iframe> created by the section's JS sits absolutely inside the same
   card div and covers the area that the thumbnail used to occupy. */
.homepage-trust-section__item-{{ section_id }}--video.is-playing img,
.homepage-trust-section__item-{{ section_id }}--video.is-playing .homepage-trust-section__video-overlay-{{ section_id }} {
  display: none;
}

.homepage-trust-section__item-{{ section_id }}--video video,
.homepage-trust-section__item-{{ section_id }}--video iframe {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  border: none;
  background: #000;
}

/* Media Feature Item */
.homepage-trust-section__item-{{ section_id }}--media {
  padding: 24px;
  display: flex;
  flex-direction: column;
}

.homepage-trust-section__item-{{ section_id }}--media.variant-light {
  background-color: var(--trust-card-bg);
}

.homepage-trust-section__item-{{ section_id }}--media.variant-dark {
  background-color: var(--trust-media-bg);
}

.homepage-trust-section__item-{{ section_id }}--media.variant-dark .homepage-trust-section__media-quote-{{ section_id }},
.homepage-trust-section__item-{{ section_id }}--media.variant-dark .homepage-trust-section__media-label-{{ section_id }} {
  color: #ffffff;
}

.homepage-trust-section__media-quote-{{ section_id }} {
  font-family: 'sofia-pro', sans-serif;
  font-weight: 400;
  font-size: 16px;
  line-height: 1.5;
  margin: 0 0 auto 0;
  color: var(--trust-text-color);
}

.homepage-trust-section__media-footer-{{ section_id }} {
  margin-top: 16px;
}

.homepage-trust-section__media-label-{{ section_id }} {
  font-family: 'sofia-pro', sans-serif;
  font-weight: 400;
  font-size: 12px;
  line-height: 1.3;
  margin: 0 0 8px 0;
  color: var(--trust-text-color);
  opacity: 0.7;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.homepage-trust-section__media-logo-{{ section_id }} {
  max-width: 120px;
  height: auto;
}

.homepage-trust-section__media-logo-{{ section_id }} img {
  width: 100%;
  height: auto;
  object-fit: contain;
}

/* Media Split Card */
.homepage-trust-section__item-{{ section_id }}--media-split {
  display: flex;
  flex-direction: column;
  gap: 16px;
  background: transparent;
}

.homepage-trust-section__media-split-quote-{{ section_id }} {
  flex: 0 0 calc((100% - 16px) / 2);
  height: calc((100% - 16px) / 2);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20px;
  padding: 24px;
  background-color: var(--trust-card-bg);
  border-radius: 8px;
  min-height: 0;
  box-sizing: border-box;
}

.homepage-trust-section__media-split-text-{{ section_id }} {
  font-family: 'sofia-pro', sans-serif;
  font-weight: 400;
  font-size: 16px;
  line-height: 1.4;
  text-align: center;
  color: var(--trust-text-color);
}
.homepage-trust-section__media-split-text-{{ section_id }} p {
margin: 0px;
}

.homepage-trust-section__media-split-logo-{{ section_id }} {
  max-width: 120px;
}

.homepage-trust-section__media-split-logo-{{ section_id }} img {
  width: 100%;
  height: auto;
  object-fit: contain;
}

.homepage-trust-section__media-split-image-{{ section_id }} {
  flex: 0 0 calc((100% - 16px) / 2);
  height: calc((100% - 16px) / 2);
  border-radius: 8px;
  overflow: hidden;
  min-height: 0;
}

.homepage-trust-section__media-split-image-{{ section_id }} img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* ==========================================================================
   Carousel Controls
   ========================================================================== */
.homepage-trust-section__carousel-controls-{{ section_id }} {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16px;
  margin: 32px 0;
}

.homepage-trust-section__carousel-btn-{{ section_id }} {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  border: 1px solid rgba(0, 0, 0, 0.1);
  background: #ffffff;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.homepage-trust-section__carousel-btn-{{ section_id }}:hover {
  background: #f5f5f5;
}

.homepage-trust-section__carousel-btn-{{ section_id }}:disabled {
  opacity: 0.4;
  cursor: not-allowed;
}

.homepage-trust-section__carousel-btn-{{ section_id }} svg {
  width: 20px;
  height: 20px;
  fill: var(--trust-text-color);
}

.homepage-trust-section__carousel-dots-{{ section_id }} {
  display: flex;
  gap: 8px;
}

.homepage-trust-section__carousel-dot-{{ section_id }} {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  border: none;
  background: rgba(0, 0, 0, 0.2);
  cursor: pointer;
  padding: 0;
  transition: all 0.2s ease;
}

.homepage-trust-section__carousel-dot-{{ section_id }}.is-active {
  background: var(--trust-text-color);
}

/* ==========================================================================
   Statistics Section
   ========================================================================== */
.homepage-trust-section__stats-{{ section_id }} {
  display: flex;
  gap: 16px;
  justify-content: space-between;
}

.homepage-trust-section__stat-card-{{ section_id }} {
  flex: 1;
  background: #ffffff;
  border: 1px solid rgba(0, 0, 0, 0.06);
  border-radius: 8px;
  padding: 20px;
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
  min-height: 99px;
}

.homepage-trust-section__stat-content-{{ section_id }} {
  display: flex;
  flex-direction: column;
  gap: 8px;
  flex: 1;
  min-width: 0;
}

.homepage-trust-section__stat-row-{{ section_id }} {
  display: flex;
  align-items: center;
  gap: 8px;
  width: 100%;
}

.homepage-trust-section__stat-badge-{{ section_id }} {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--trust-text-color);
  border-radius: 999px;
  padding: 2px 12px;
  flex-shrink: 0;
}

.homepage-trust-section__stat-badge-{{ section_id }} span {
  font-family: 'sofia-pro', sans-serif;
  font-weight: 500;
  font-size: 16px;
  line-height: 1.4;
  color: var(--trust-text-color);
}

.homepage-trust-section__stat-text-line1-{{ section_id }} {
  font-family: 'sofia-pro', sans-serif;
  font-weight: 400;
  font-size: 16px;
  line-height: 1.4;
  color: var(--trust-text-color);
}

.homepage-trust-section__stat-text-line2-{{ section_id }} {
  font-family: 'sofia-pro', sans-serif;
  font-weight: 400;
  font-size: 16px;
  line-height: 1.4;
  margin: 0;
  color: var(--trust-text-color);
}

.homepage-trust-section__stat-value-{{ section_id }} {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-shrink: 0;
}

.homepage-trust-section__stat-arrow-{{ section_id }} {
  width: 20px;
  height: 20px;
  border-radius: 50%;
  background: var(--trust-text-color);
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
}

.homepage-trust-section__stat-value-{{ section_id }} span {
  font-family: 'sofia-pro', sans-serif;
  font-weight: 600;
  font-size: 28px;
  line-height: 1;
  color: var(--trust-text-color);
}

.homepage-trust-section__stat-arrow-{{ section_id }} svg {
  width: 12px;
  height: 12px;
  stroke: #ffffff;
  {% comment %}stroke-linecap: round;{% endcomment %}
  {% comment %}stroke-linejoin: round;{% endcomment %}
  {% comment %}stroke-width: 2;{% endcomment %}
  fill: none;
}

/* ==========================================================================
   Visibility Utilities
   ========================================================================== */
.homepage-trust-section__desktop-only-{{ section_id }} {
  display: flex;
}

.homepage-trust-section__mobile-only-{{ section_id }} {
  display: none;
}

@media screen and (min-width: 750px) {
  .homepage-trust-section__carousel-{{ section_id }} {
    margin-bottom: 0;
  }

  .homepage-trust-section__carousel-{{ section_id }} {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
  }

  .homepage-trust-section__carousel-viewport-{{ section_id }} {
    padding: 0 140px;
    box-sizing: border-box;
  }

  .homepage-trust-section__stat-card-{{ section_id }} {
    min-height: 101px;
  }

  .homepage-trust-section__stat-badge-{{ section_id }} span,
  .homepage-trust-section__stat-text-line1-{{ section_id }},
  .homepage-trust-section__stat-text-line2-{{ section_id }} {
    font-size: 18px;
    line-height: 1.3;
  }

  .homepage-trust-section__stat-badge-{{ section_id }} span {
    font-weight: 500;
  }

  .homepage-trust-section__stat-value-{{ section_id }} {
    gap: 10px;
  }

  .homepage-trust-section__stat-arrow-{{ section_id }} {
    width: 24px;
    height: 24px;
  }

  .homepage-trust-section__stat-arrow-{{ section_id }} svg {
    width: 14px;
    height: 14px;
  }

  .homepage-trust-section__stat-value-{{ section_id }} span {
    font-size: 32px;
    line-height: 1;
  }
}

/* ==========================================================================
   Statistics — tablet / narrow desktop (max-width: 989px)
   Three-across stat cards need more width; keep stacked layout until 990px.
   ========================================================================== */
@media screen and (max-width: 989px) {
  .homepage-trust-section__stats-{{ section_id }} {
    flex-direction: column;
    gap: 12px;
    padding: 0 16px;
  }

  .homepage-trust-section__stat-card-{{ section_id }} {
    gap: 10px;
  }

  .homepage-trust-section__stat-row-{{ section_id }} {
    flex-wrap: wrap;
  }
}

/* ==========================================================================
   Responsive - Mobile (max-width: 749px)
   ========================================================================== */
@media screen and (max-width: 749px) {
  /* Remove horizontal padding for edge-to-edge carousel */
  .homepage-trust-section-{{ section_id }} {
    padding: 32px 0;
  }

  /* Add horizontal padding to title */
  .homepage-trust-section__title-{{ section_id }} {
    font-size: 26px;
    margin-bottom: 16px;
    padding: 0 16px;
  }

  .homepage-trust-section__carousel-{{ section_id }} {
    margin-bottom: 32px;
  }

  .homepage-trust-section__carousel-viewport-{{ section_id }} {
    overflow: hidden;
  }

  /* Carousel track - transform-based carousel on mobile */
  .homepage-trust-section__carousel-track-{{ section_id }} {
    width: max-content;
    padding: 4px 16px;
    transition: none;
    will-change: transform;
  }

  /* Hide carousel controls on mobile */
  .homepage-trust-section__carousel-controls-{{ section_id }} {
    display: none;
  }

  /* Visibility utilities on mobile */
  .homepage-trust-section__desktop-only-{{ section_id }} {
    display: none !important;
  }

  .homepage-trust-section__mobile-only-{{ section_id }} {
    display: flex;
  }
}

/* ==========================================================================
   Reduced Motion
   ========================================================================== */
@media (prefers-reduced-motion: reduce) {
  .homepage-trust-section__carousel-track-{{ section_id }} {
    transition: none !important;
  }

  .homepage-trust-section__play-button-{{ section_id }},
  .homepage-trust-section__carousel-btn-{{ section_id }},
  .homepage-trust-section__carousel-dot-{{ section_id }} {
    transition: none;
  }
}
</style>
