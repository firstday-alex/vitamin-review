{%- style -%}
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    {%- if section.settings.image != blank %}
      --image-ratio-percent: {{ 1 | divided_by: section.settings.image.aspect_ratio | times: 100 }}%;
      --image-position: {{ section.settings.image_position }};
    {% endif -%}
    {%- if section.settings.use_custom_colors %}
      --gradient-background: {% if section.settings.gradient_background != blank %}{{ section.settings.gradient_background }}{% else %}{{ section.settings.colors_background }}{% endif %};
      --color-background: {{ section.settings.colors_background.red }}, {{ section.settings.colors_background.green }}, {{ section.settings.colors_background.blue }};
      --color-foreground: {{ section.settings.colors_text.red }}, {{ section.settings.colors_text.green }}, {{ section.settings.colors_text.blue }};
      --color-link: var(--color-foreground);
      --color-border: var(--color-foreground);
      --color-heading: var(--color-foreground);
      --color-button-background: {{ section.settings.colors_button_background.red }}, {{ section.settings.colors_button_background.green }}, {{ section.settings.colors_button_background.blue }};
      --color-button-text: {{ section.settings.colors_button_label.red }}, {{ section.settings.colors_button_label.green }}, {{ section.settings.colors_button_label.blue }};
      --color-button-border: var(--color-button-background);
      --color-shadow: var(--color-foreground);
    {% endif -%}
    --shadow-opacity: 0.3;
    --iwt-accent-color: {{ section.settings.accent_color | default: 'inherit' }};
  }
  {%- if section.settings.image_mobile != blank and section.settings.mobile_image_ratio == 'adapt' %}
    @media screen and (max-width: 749px) {
      #shopify-section-{{ section.id }} {
        --image-ratio-percent: {{ 1 | divided_by: section.settings.image_mobile.aspect_ratio | times: 100 }}%;
      }
    }
  {% endif -%}
  #shopify-section-{{ section.id }} .iwt-accent { color: var(--iwt-accent-color, inherit); }
  .button { text-transform: none; }

  #shopify-section-{{ section.id }} .iwt-video-container {
    position: relative;
    cursor: pointer;
    display: block;
    width: 100%;
    height: 100%;
  }
  #shopify-section-{{ section.id }} .iwt-video-container::after {
    content: "";
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.15);
    pointer-events: none;
    transition: opacity 0.2s ease;
  }
  #shopify-section-{{ section.id }} .iwt-video-container.is-playing::after,
  #shopify-section-{{ section.id }} .iwt-video-container.is-playing .iwt-play-btn,
  #shopify-section-{{ section.id }} .iwt-video-container.is-playing img {
    display: none;
  }
  #shopify-section-{{ section.id }} .iwt-video-container video,
  #shopify-section-{{ section.id }} .iwt-video-container iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: none;
  }
  #shopify-section-{{ section.id }} .iwt-play-btn {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 64px;
    height: 64px;
    background: rgba(255, 255, 255, 0.95);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(2px);
    z-index: 1;
    border: none;
    cursor: pointer;
    transition: transform 0.2s ease;
  }
  #shopify-section-{{ section.id }} .iwt-play-btn:hover {
    transform: translate(-50%, -50%) scale(1.08);
  }
  #shopify-section-{{ section.id }} .iwt-play-btn svg {
    width: 24px;
    height: 24px;
    fill: #000;
    margin-left: 3px;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .section--padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-right: {{ section.settings.padding_right | default: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      padding-left: {{ section.settings.padding_left | default: 0 }}px;
    }
  }
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .section--padding {
      padding-top: {{ section.settings.mobile_padding_top | default: 0 }}px;
      padding-right: {{ section.settings.mobile_padding_right | default: 0 }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom | default: 0 }}px;
      padding-left: {{ section.settings.mobile_padding_left | default: 0 }}px;
    }
  }

  /* ── Badge overlay ── */
  #shopify-section-{{ section.id }} .media-wrapper {
    position: relative;
  }
  #shopify-section-{{ section.id }} .iwt-badges-overlay {
    position: absolute;
    top: {{ section.settings.badge_offset_top | default: 20 }}px;
    right: {{ section.settings.badge_offset_right | default: 16 }}px;
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.badge_gap | default: 10 }}px;
    z-index: 2;
    pointer-events: none;
  }
  #shopify-section-{{ section.id }} .iwt-badge {
    background: {{ section.settings.badge_bg_color | default: 'rgba(200,169,110,0.95)' }};
    color: {{ section.settings.badge_text_color | default: '#ffffff' }};
    border-radius: {{ section.settings.badge_radius | default: 12 }}px;
    width: {{ section.settings.badge_size | default: 96 }}px;
    height: {{ section.settings.badge_size | default: 96 }}px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 8px 6px;
    font-size: {{ section.settings.badge_font_size | default: 11 }}px;
    font-weight: 600;
    line-height: 1.25;
  }
  #shopify-section-{{ section.id }} .iwt-badge img {
    max-width: 75%;
    max-height: 50%;
    object-fit: contain;
    margin-bottom: 4px;
  }
  #shopify-section-{{ section.id }} .iwt-badge__number {
    font-size: {{ section.settings.badge_number_font_size | default: 22 }}px;
    font-weight: 800;
    line-height: 1;
    display: block;
  }

  /* ── Icon tile grid ── */
  #shopify-section-{{ section.id }} .iwt-icon-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ section.settings.icon_gap | default: 12 }}px;
    margin-top: {{ section.settings.icon_grid_margin_top | default: 24 }}px;
    margin-bottom: {{ section.settings.icon_grid_margin_bottom | default: 0 }}px;
    width:100%;
  }
  #shopify-section-{{ section.id }} .iwt-icon-tile {
    background: {{ section.settings.icon_tile_bg | default: 'rgba(255,255,255,0.8)' }};
    border-radius: {{ section.settings.icon_tile_radius | default: 14 }}px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    gap: 10px;
    padding: 16px 10px {{ section.settings.icon_tile_padding_bottom | default: 20 }}px;
    text-align: center;
    position: relative;
    /* top space reserved for the overhanging icon bubble */
    margin-top: calc({{ section.settings.icon_bubble_size | default: 56 }}px / 2);
    padding-top: calc({{ section.settings.icon_bubble_size | default: 56 }}px / 2 + 10px);
  }
  /* The circular icon bubble sits on the top edge of the card */
  #shopify-section-{{ section.id }} .iwt-icon-bubble {
    position: absolute;
    top: calc(-1 * {{ section.settings.icon_bubble_size | default: 56 }}px / 2);
    left: 50%;
    transform: translateX(-50%);
    width: {{ section.settings.icon_bubble_size | default: 56 }}px;
    height: {{ section.settings.icon_bubble_size | default: 56 }}px;
    border-radius: 50%;
    background: {{ section.settings.icon_bubble_bg | default: section.settings.icon_tile_bg | default: 'rgba(255,255,255,0.8)' }};
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  #shopify-section-{{ section.id }} .iwt-icon-bubble img {
    width: {{ section.settings.icon_img_size | default: 32 }}px;
    height: {{ section.settings.icon_img_size | default: 32 }}px;
    object-fit: contain;
  }
  #shopify-section-{{ section.id }} .iwt-icon-tile__label {
    font-size: {{ section.settings.icon_label_size | default: 13 }}px;
    font-weight: 600;
    color: {{ section.settings.icon_label_color | default: 'inherit' }};
    line-height: 1.2;
  }
{%- endstyle -%}

{% render 'section-image-with-text.css' %}

{%- liquid
  assign grid_class = 'image-with-text__grid'
  if section.settings.layout == 'text_first'
    assign grid_class = grid_class | append: ' image-with-text__grid--reverse'
  endif

  if section.settings.mobile_layout == 'text_first'
    assign grid_class = grid_class | append: ' image-with-text__grid-mobile--reverse'
  endif

  if section.settings.mobile_layout == 'no_image'
    assign grid_class = grid_class | append: ' image-with-text__grid-mobile--no-image'
  endif

  if section.settings.mobile_layout == 'overlap'
    assign grid_class = grid_class | append: ' image-with-text__grid-mobile--overlap'
  endif
-%}

{%- liquid
  if section.settings.top_waves
    assign containerPaddingTop = '40px'
  else
    assign containerPaddingTop = '0'
  endif

  if section.settings.bottom_waves
    assign containerPaddingBottom = '40px'
  else
    assign containerPaddingBottom = '0'
  endif

  assign has_heading = false
  assign has_text = false
  assign has_button = false
  assign default_heading = 'Image with text'
  assign default_text = 'Pair text with an image to focus on your chosen product, collection, or blog post. Add details on availability, style, or even provide a review.'
  assign default_button_label = 'Button label'
  for block in section.blocks
    case block.type
      when 'heading'
        assign heading_value = block.settings.heading | strip
        if heading_value != blank and heading_value != default_heading
          assign has_heading = true
        endif
      when 'text'
        assign text_value = block.settings.text | strip_html | strip
        if text_value != blank and text_value != default_text
          assign has_text = true
        endif
      when 'button'
        assign button_value = block.settings.button_label | strip
        if button_value != blank and button_value != default_button_label
          assign has_button = true
        endif
      when 'icon_tile'
        if block.settings.icon_image != blank or block.settings.icon_label != blank
          assign has_button = true
        endif
    endcase
  endfor
-%}

{%- comment -%} Pre-check: do any badge blocks have content? {%- endcomment -%}
{%- assign has_badges = false -%}
{%- for block in section.blocks -%}
  {%- if block.type == 'badge' -%}
    {%- if block.settings.badge_label != blank or block.settings.badge_number != blank or block.settings.badge_icon != blank -%}
      {%- assign has_badges = true -%}
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}

{%- if has_heading or has_text or has_button -%}
{% if section.settings.top_waves %}
  {% render 'waves', wavePosition: 'top', color: section.settings.background_color, containerBackground: section.settings.wavesTopBackgroundColor %}
{% endif %}

<div style="{% if section.settings.enable_background_color_section %}background-color: {{ section.settings.background_color_section }};{% endif %} padding-top: {{ containerPaddingTop }}; padding-bottom: {{ containerPaddingBottom }}; margin-top:-1px;">
  <div class="section--padding{% if section.settings.show_divider %} section--divider{% endif %}">
    <div class="image-with-text{% if section.settings.use_custom_colors and section.settings.colors_background != settings.colors_background %} image-with-text--colored{% else %} image-with-text--alt{% endif %}{% if section.settings.enlarge_content %} image-with-text--enlarge{% endif %} page-width{% if section.settings.full_width %} page-width--full-width{% endif %}" {% if section.settings.enable_background_color_section %}style="background-color: {{ section.settings.background_color_section }};"{% endif %}>
      <div class="{{ grid_class }} grid grid--gapless grid--1-col grid--2-col-tablet" {% if section.settings.enable_background_color_section %}style="background-color: {{ section.settings.background_color_section }};"{% endif %}>

        {%- comment -%} ── IMAGE COLUMN ── {%- endcomment -%}
        <div class="grid__item">
          <use-animate data-animate="zoom-fade" class="media-wrapper" style="background: transparent; {% if section.settings.enable_box_shadow %}box-shadow: 5px 5px 0px 0px {{ section.settings.box_shadow_color }}; border: {{ section.settings.border }}px solid {{ section.settings.box_shadow_color }}; {% endif %} {% if section.settings.enable_border_radius %}border-radius: {{ section.settings.border_radius }}px; {% endif %}">
            <div class="image-animate media--{{ section.settings.image_ratio }} media-mobile--{{ section.settings.mobile_image_ratio }} {% if section.settings.image != blank %}media{% else %}media--placeholder{% endif %}{% if section.settings.image_behavior != 'none' %} animate--{{ section.settings.image_behavior }}{% endif %}">
              {%- if section.settings.image != blank -%}

                {%- if section.settings.video_url != blank -%}
                  <div class="iwt-video-container" data-video-url="{{ section.settings.video_url | escape }}">
                {%- else -%}
                  <a {% if section.settings.image_link != blank %}href="{{ section.settings.image_link }}"{% else %}role="link" aria-disabled="true"{% endif %}>
                {%- endif -%}

                    {%- if section.settings.image_behavior == 'ambient' -%}
                        {%- assign widths = '198, 432, 642, 900, 1320, 1800' -%}
                        {%- capture sizes -%}
                            (min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 1.6667 }}px,
                            (min-width: 750px) calc((100vw - 10rem) / 1.667), {% if section.settings.full_width %} calc(100vw / 1.667){% else %} calc((100vw - 3rem) / 1.667){% endif %}
                        {%- endcapture -%}
                    {%- else -%}
                        {%- assign widths = '165, 360, 535, 750, 1100, 1500' -%}
                        {%- capture sizes -%}
                            (min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 2 }}px,
                            (min-width: 750px) calc((100vw - 10rem) / 2), {% if section.settings.full_width %} 50vw{% else %} calc((100vw - 3rem) / 2){% endif %}
                        {%- endcapture -%}
                    {%- endif -%}
                    {%- liquid
                        if section.settings.image_mobile == blank
                            echo section.settings.image | image_url: width: 1500 | image_tag: loading: 'lazy', class: 'image-fit', sizes: sizes, widths: widths, is: 'lazy-image'
                        else
                            echo section.settings.image_mobile | image_url: width: 1500 | image_tag: loading: 'lazy', class: 'image-fit medium-hide large-up-hide', sizes: sizes, widths: widths, is: 'lazy-image'
                            echo section.settings.image | image_url: width: 1500 | image_tag: loading: 'lazy', class: 'image-fit small-hide', sizes: sizes, widths: widths, is: 'lazy-image'
                        endif
                    -%}

                {%- if section.settings.video_url != blank -%}
                    <button type="button" class="iwt-play-btn" aria-label="Play video">
                      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
                    </button>
                  </div>
                {%- else -%}
                  </a>
                {%- endif -%}

              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'placeholder' }}
              {%- endif -%}
            </div>

            {%- comment -%} ── BADGE OVERLAY ── {%- endcomment -%}
            {%- if has_badges -%}
              <div class="iwt-badges-overlay">
                {%- for block in section.blocks -%}
                  {%- if block.type == 'badge' -%}
                    {%- if block.settings.badge_label != blank or block.settings.badge_number != blank or block.settings.badge_icon != blank -%}
                      <div class="iwt-badge" {{ block.shopify_attributes }}>
                        {%- if block.settings.badge_icon != blank -%}
                          <img
                            src="{{ block.settings.badge_icon | image_url: width: 120 }}"
                            alt="{{ block.settings.badge_label | escape }}"
                            loading="lazy"
                            width="80"
                            height="80"
                          >
                        {%- endif -%}
                        {%- if block.settings.badge_number != blank -%}
                          <span class="iwt-badge__number">{{ block.settings.badge_number }}</span>
                        {%- endif -%}
                        {%- if block.settings.badge_label != blank -%}
                          <span>{{ block.settings.badge_label | escape }}</span>
                        {%- endif -%}
                      </div>
                    {%- endif -%}
                  {%- endif -%}
                {%- endfor -%}
              </div>
            {%- endif -%}

          </use-animate>
        </div>

        {%- comment -%} ── CONTENT COLUMN ── {%- endcomment -%}
        <div class="grid__item">
          <div class="image-with-text__content {{ section.settings.text_box_position }} {{ section.settings.text_alignment }} mobile-{{ section.settings.mobile_text_alignment }}">
            {%- assign icon_grid_open = false -%}
            {%- for block in section.blocks -%}
              {%- comment -%} Close icon grid if we hit a non-icon block after opening it {%- endcomment -%}
              {%- if icon_grid_open and block.type != 'icon_tile' -%}
                </div>
                {%- assign icon_grid_open = false -%}
              {%- endif -%}

              {% case block.type %}
                {%- when 'heading' -%}
                  <{{ block.settings.heading_tag }} class="image-with-text__heading {{ block.settings.heading_size }}" {{ block.shopify_attributes }}>{{ block.settings.heading | escape | replace: '[', '<span class="iwt-accent">' | replace: ']', '</span>' }}</{{ block.settings.heading_tag }}>

                {%- when 'subheading' -%}
                  <p class="image-with-text__subheading{% if block.settings.secondary_color %} image-with-text__subheading--colored{% endif %} {{ block.settings.subheading_size }}" {{ block.shopify_attributes }}>{{ block.settings.subheading | escape | replace: '[', '<span class="iwt-accent">' | replace: ']', '</span>' }}</p>

                {%- when 'text' -%}
                  <div class="image-with-text__text{% if block.settings.secondary_color %} image-with-text__text--colored{% endif %} {{ block.settings.text_size }} rte" {{ block.shopify_attributes }}>{{ block.settings.text | replace: '[', '<span class="iwt-accent">' | replace: ']', '</span>' }}</div>

                {%- when 'custom_liquid' -%}
                  <div class="image-with-text__text rte" {{ block.shopify_attributes }}>{{ block.settings.custom_liquid }}</div>

                {%- when 'button' -%}
                  {%- if block.settings.button_label != blank -%}
                    {%- if block.settings.button_style_secondary -%}
                      <a class="button button--cta button--{{ block.settings.button_size }}"{% if block.settings.button_link != blank %} href="{{ block.settings.button_link }}"{% else %} role="link" aria-disabled="true"{% endif %} {{ block.shopify_attributes }}>
                        <span class="label">{{ block.settings.button_label | escape }}</span>
                        {% render 'icon', icon: 'arrow' %}
                      </a>
                    {%- else -%}
                      <a class="button button--{{ block.settings.button_size }}"{% if block.settings.button_link != blank %} href="{{ block.settings.button_link }}"{% else %} role="link" aria-disabled="true"{% endif %} {{ block.shopify_attributes }}>
                        {{ block.settings.button_label | escape }}
                      </a>
                    {%- endif -%}
                  {%- endif -%}

                {%- when 'badge' -%}
                  {%- comment -%} Badges render on the image side only — nothing here {%- endcomment -%}

                {%- when 'icon_tile' -%}
                  {%- if block.settings.icon_image != blank or block.settings.icon_label != blank -%}
                    {%- unless icon_grid_open -%}
                      <div class="iwt-icon-grid">
                      {%- assign icon_grid_open = true -%}
                    {%- endunless -%}
                    <div class="iwt-icon-tile" {{ block.shopify_attributes }}>
                      {%- if block.settings.icon_image != blank -%}
                        <div class="iwt-icon-bubble">
                          <img
                            src="{{ block.settings.icon_image | image_url: width: 120 }}"
                            alt="{{ block.settings.icon_label | escape }}"
                            loading="lazy"
                            width="{{ section.settings.icon_img_size | default: 32 }}"
                            height="{{ section.settings.icon_img_size | default: 32 }}"
                          >
                        </div>
                      {%- endif -%}
                      {%- if block.settings.icon_label != blank -%}
                        <span class="iwt-icon-tile__label">{{ block.settings.icon_label | escape }}</span>
                      {%- endif -%}
                    </div>
                  {%- endif -%}

              {%- endcase -%}
            {%- endfor -%}
            {%- comment -%} Close icon grid if it was the last thing in the loop {%- endcomment -%}
            {%- if icon_grid_open -%}</div>{%- endif -%}
          </div>
        </div>

      </div>
    </div>
  </div>
</div>
{% if section.settings.bottom_waves %}
    {% render 'waves', wavePosition: 'bottom', color: section.settings.background_color, containerBackground: section.settings.wavesBottomBackgroundColor %}
{% endif %}

{%- if section.settings.video_url != blank -%}
<script>
  (function() {
    const section = document.getElementById('shopify-section-{{ section.id }}');
    if (!section) return;
    const containers = section.querySelectorAll('.iwt-video-container');
    if (!containers.length) return;

    function createVideoElement(url) {
      if (!url) return null;
      const youtubeMatch = url.match(/(?:youtube\.com\/(?:watch\?v=|embed\/)|youtu\.be\/)([a-zA-Z0-9_-]{11})/);
      if (youtubeMatch) {
        const iframe = document.createElement('iframe');
        iframe.src = 'https://www.youtube.com/embed/' + youtubeMatch[1] + '?autoplay=1&rel=0';
        iframe.allow = 'autoplay; encrypted-media';
        iframe.allowFullscreen = true;
        return iframe;
      }
      const vimeoMatch = url.match(/vimeo\.com\/(?:video\/)?(d+)/);
      if (vimeoMatch) {
        const iframe = document.createElement('iframe');
        iframe.src = 'https://player.vimeo.com/video/' + vimeoMatch[1] + '?autoplay=1';
        iframe.allow = 'autoplay; fullscreen';
        iframe.allowFullscreen = true;
        return iframe;
      }
      const video = document.createElement('video');
      video.src = url;
      video.controls = true;
      video.autoplay = true;
      video.playsInline = true;
      return video;
    }

    containers.forEach(function(container) {
      container.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        if (container.classList.contains('is-playing')) return;
        const videoUrl = container.getAttribute('data-video-url');
        const videoElement = createVideoElement(videoUrl);
        if (!videoElement) return;
        container.classList.add('is-playing');
        container.appendChild(videoElement);
      });
    });
  })();
</script>
{%- endif -%}
{%- endif -%}


{% schema %}
{
  "name": "t:sections.image-with-text.name",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "header", "content": "Section Background" },
    { "type": "checkbox", "id": "enable_background_color_section", "default": false, "label": "Enable section background color" },
    { "type": "color", "id": "background_color_section", "default": "#A8E8E2", "label": "Section Background" },
    { "type": "header", "content": "Waves" },
    { "type": "color", "id": "background_color", "default": "#A8E8E2", "label": "Color of the wave" },
    { "type": "checkbox", "id": "top_waves", "default": false, "label": "Enable waves on top" },
    { "type": "color", "id": "wavesTopBackgroundColor", "default": "#F2FBFE", "label": "Background color of the top wave" },
    { "type": "checkbox", "id": "bottom_waves", "default": false, "label": "Enable waves on bottom" },
    { "type": "color", "id": "wavesBottomBackgroundColor", "default": "#F2FBFE", "label": "Background color of the bottom wave" },
    { "type": "image_picker", "id": "image", "label": "t:sections.all.image.label" },
    { "type": "url", "id": "image_link", "label": "Image link" },
    { "type": "url", "id": "video_url", "label": "Video URL (optional)", "info": "YouTube, Vimeo, or direct MP4/WebM link. The image above is used as the play thumbnail. When set, Image link is ignored." },
    { "type": "checkbox", "id": "enable_box_shadow", "default": false, "label": "Enable box shadow" },
    { "type": "color", "id": "box_shadow_color", "default": "#A8E8E2", "label": "Box shadow color" },
