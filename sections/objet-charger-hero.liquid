{%- comment -%}
  Objet Charger Hero
  A fully self-contained landing hero section: full-bleed background image,
  centered logo, headline, email capture with a discount CTA, and price/date lines.
  All HTML, CSS and JS live inside this file.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign uid = section.id
-%}

<div
  id="ObjetHero-{{ uid }}"
  class="objet-hero"
  style="
    --objet-min-height: {{ s.section_height }}svh;
    --objet-overlay-opacity: {{ s.overlay_opacity | divided_by: 100.0 }};
    --objet-text-color: {{ s.text_color }};
    --objet-content-max-width: {{ s.content_max_width }}px;
    --objet-btn-bg: {{ s.button_background }};
    --objet-btn-color: {{ s.button_text_color }};
  "
>
  {%- comment -%} Background media {%- endcomment -%}
  <div class="objet-hero__media">
    {%- if s.background_image != blank -%}
      {{
        s.background_image
        | image_url: width: 3840
        | image_tag:
          widths: '750, 1100, 1500, 2000, 2600, 3200, 3840',
          sizes: '100vw',
          class: 'objet-hero__img',
          fetchpriority: 'high',
          alt: s.background_image.alt | default: s.heading
      }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'objet-hero__img objet-hero__img--placeholder' }}
    {%- endif -%}
    <div class="objet-hero__overlay"></div>
  </div>

  {%- comment -%} Logo / brand at the top {%- endcomment -%}
  {%- if s.logo != blank -%}
    <div class="objet-hero__logo">
      {{
        s.logo
        | image_url: width: 600
        | image_tag: widths: '150, 300, 450, 600', class: 'objet-hero__logo-img', alt: s.logo_text | default: 'Logo'
      }}
    </div>
  {%- elsif s.logo_text != blank -%}
    <div class="objet-hero__logo objet-hero__logo--text">{{ s.logo_text }}</div>
  {%- endif -%}

  {%- comment -%} Content block {%- endcomment -%}
  <div class="objet-hero__content">
    {%- if s.eyebrow != blank -%}
      <p class="objet-hero__eyebrow">{{ s.eyebrow }}</p>
    {%- endif -%}
    {%- if s.heading != blank -%}
      <h1 class="objet-hero__heading">{{ s.heading }}</h1>
    {%- endif -%}

    {%- if s.show_form -%}
      {%- form 'customer', class: 'objet-hero__form-wrap' -%}
        <input type="hidden" name="contact[tags]" value="newsletter, objet-charger">
        <div class="objet-hero__form">
          <label class="visually-hidden" for="ObjetEmail-{{ uid }}">{{ s.email_placeholder }}</label>
          <input
            class="objet-hero__input"
            id="ObjetEmail-{{ uid }}"
            type="email"
            name="contact[email]"
            placeholder="{{ s.email_placeholder }}"
            autocorrect="off"
            autocapitalize="off"
            autocomplete="email"
            required
            {%- if form.errors and form.id == blank %}
              autofocus
              aria-invalid="true"
              aria-describedby="ObjetMessage-{{ uid }}"
            {%- elsif form.posted_successfully? and form.id == blank %}
              aria-describedby="ObjetMessage-{{ uid }}"
            {%- endif %}
          >
          <button class="objet-hero__button" type="submit">{{ s.button_label }}</button>
        </div>

        {%- if form.errors and form.id == blank -%}
          <p
            id="ObjetMessage-{{ uid }}"
            class="objet-hero__message"
            data-state="error"
            tabindex="-1"
          >
            {{- form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email -}}
          </p>
        {%- elsif form.posted_successfully? and form.id == blank -%}
          <p
            id="ObjetMessage-{{ uid }}"
            class="objet-hero__message"
            data-state="success"
            tabindex="-1"
          >
            {{ s.success_message }}
          </p>
        {%- endif -%}
      {%- endform -%}
    {%- endif -%}

    {%- if s.price_text != blank -%}
      <p class="objet-hero__price">{{ s.price_text }}</p>
    {%- endif -%}
    {%- if s.date_text != blank -%}
      <p class="objet-hero__date">{{ s.date_text }}</p>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .objet-hero {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    min-height: var(--objet-min-height, 100svh);
    padding: 24px 20px 48px;
    box-sizing: border-box;
    overflow: hidden;
    color: var(--objet-text-color, #ffffff);
    text-align: center;
  }

  .objet-hero__media,
  .objet-hero__overlay,
  .objet-hero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .objet-hero__img {
    object-fit: cover;
    object-position: center;
  }

  .objet-hero__img--placeholder {
    background: #e9e6df;
  }

  .objet-hero__overlay {
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0) 35%,
      rgba(0, 0, 0, calc(0.55 * var(--objet-overlay-opacity, 1))) 100%
    );
  }

  .objet-hero__logo {
    position: absolute;
    top: 28px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .objet-hero__logo-img {
    width: auto;
    max-width: 160px;
    height: auto;
  }

  .objet-hero__logo--text {
    font-size: 2.4rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    line-height: 1;
  }

  .objet-hero__content {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: var(--objet-content-max-width, 520px);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }

  .objet-hero__eyebrow {
    margin: 0;
    font-size: 2.1rem;
    font-weight: 400;
    line-height: 1.1;
  }

  .objet-hero__heading {
    margin: 0 0 22px;
    font-size: 2.6rem;
    font-weight: 400;
    line-height: 1.1;
  }

  .objet-hero__form-wrap {
    width: 100%;
    margin: 0 0 20px;
  }

  .objet-hero__form {
    display: flex;
    width: 100%;
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.18);
  }

  .objet-hero__input {
    flex: 1 1 auto;
    min-width: 0;
    border: none;
    padding: 18px 20px;
    font-size: 1.05rem;
    color: #222;
    background: #ffffff;
    outline: none;
  }

  .objet-hero__input::placeholder {
    color: #9a9a9a;
  }

  .objet-hero__input:focus-visible {
    box-shadow: inset 0 0 0 2px rgba(60, 60, 60, 0.4);
  }

  .objet-hero__button {
    flex: 0 0 auto;
    border: none;
    padding: 0 26px;
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--objet-btn-color, #ffffff);
    background: var(--objet-btn-bg, rgba(90, 90, 90, 0.85));
    cursor: pointer;
    white-space: nowrap;
    transition: filter 0.15s ease, background 0.15s ease;
  }

  .objet-hero__button:hover {
    filter: brightness(1.08);
  }

  .objet-hero__button:active {
    filter: brightness(0.95);
  }

  .objet-hero__message {
    margin: 10px 0 0;
    font-size: 0.95rem;
    font-weight: 500;
  }

  .objet-hero__message[data-state='error'] {
    color: #ffd0d0;
  }

  .objet-hero__price {
    margin: 0;
    font-size: 1.35rem;
    font-weight: 700;
  }

  .objet-hero__date {
    margin: 2px 0 0;
    font-size: 1.1rem;
    font-weight: 400;
    opacity: 0.95;
  }

  .visually-hidden {
    position: absolute !important;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media screen and (min-width: 750px) {
    .objet-hero {
      padding-bottom: 72px;
    }

    .objet-hero__eyebrow {
      font-size: 2.6rem;
    }

    .objet-hero__heading {
      font-size: 3.2rem;
    }

    .objet-hero__logo-img {
      max-width: 200px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Objet Charger Hero",
  "tag": "section",
  "class": "objet-charger-hero-section",
  "settings": [
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "range",
      "id": "section_height",
      "label": "Section height",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "svh",
      "default": 100
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Bottom overlay strength",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image",
      "info": "Optional. If empty, the logo text below is used."
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo text",
      "default": "orna"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Meet"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Objet Charger"
    },
    {
      "type": "text",
      "id": "price_text",
      "label": "Price line",
      "default": "From $70 for Early Birds"
    },
    {
      "type": "text",
      "id": "date_text",
      "label": "Date line",
      "default": "August 2nd, 2026"
    },
    {
      "type": "header",
      "content": "Email capture"
    },
    {
      "type": "checkbox",
      "id": "show_form",
      "label": "Show email form",
      "default": true
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email placeholder",
      "default": "Enter email"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "GET 30% OFF"
    },
    {
      "type": "paragraph",
      "content": "Submissions create a customer profile and are added to your email marketing list."
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thanks! Check your inbox for your discount."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#5a5a5a"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Content max width",
      "min": 360,
      "max": 720,
      "step": 20,
      "unit": "px",
      "default": 520
    }
  ],
  "presets": [
    {
      "name": "Objet Charger Hero"
    }
  ]
}
{% endschema %}
