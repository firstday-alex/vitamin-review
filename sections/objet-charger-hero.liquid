{%- comment -%}
  Objet Charger Hero (block-based)

  A Horizon-native hero built on universal blocks. The section owns the branded
  "chrome" — full-bleed background media, overlay, and a pinned top logo — while
  all content (heading, email capture, price/date, etc.) is authored with
  standard @theme blocks via {% content_for 'blocks' %}, so merchants can add,
  remove and reorder it in the theme editor.

  For an email capture, drop in the theme's "Email signup" block — it uses
  Shopify's standard {% form 'customer' %}.
{%- endcomment -%}

{%- liquid
  assign s = section.settings

  assign has_mobile_image = false
  if s.image_mobile != blank
    assign has_mobile_image = true
  endif

  assign sizes = '100vw'
  assign widths = '750, 1100, 1500, 2000, 2600, 3200, 3840'
  assign mobile_widths = '450, 600, 900, 1200, 1600'

  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif
-%}

{%- capture media -%}
  {%- if s.image != blank and has_mobile_image -%}
    <picture class="objet-hero__media">
      <source
        media="(max-width: 749px)"
        srcset="
          {%- assign mw = mobile_widths | split: ', ' -%}
          {%- for w in mw -%}
            {{ s.image_mobile | image_url: width: w }} {{ w }}w{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        "
      >
      {{
        s.image
        | image_url: width: 3840
        | image_tag:
          widths: widths,
          sizes: sizes,
          class: 'objet-hero__img',
          fetchpriority: fetch_priority,
          alt: s.image.alt | default: ''
      }}
    </picture>
  {%- elsif s.image != blank -%}
    {{
      s.image
      | image_url: width: 3840
      | image_tag:
        widths: widths,
        sizes: sizes,
        class: 'objet-hero__img',
        fetchpriority: fetch_priority,
        alt: s.image.alt | default: ''
    }}
  {%- else -%}
    {{ 'lifestyle-1' | placeholder_svg_tag: 'objet-hero__img objet-hero__img--placeholder' }}
  {%- endif -%}
{%- endcapture -%}

<div
  id="ObjetHero-{{ section.id }}"
  class="objet-hero color-{{ s.color_scheme }}"
  style="
    {%- if s.section_height == 'custom' -%}
      --objet-min-height: {{ s.section_height_custom }}svh;
    {%- elsif s.section_height == 'full-screen' -%}
      --objet-min-height: 100svh;
    {%- else -%}
      --objet-min-height: var(--section-height-{{ s.section_height }});
    {%- endif -%}
  "
  {% if request.visual_preview_mode %}
    data-shopify-visual-preview
  {% endif %}
>
  <div
    class="objet-hero__container spacing-style"
    style="{% render 'spacing-style', settings: s %}"
  >
    <div class="objet-hero__media-grid">
      {%- if s.toggle_overlay -%}
        {% render 'overlay', settings: s %}
      {%- endif -%}
      {{ media }}
    </div>

    {%- if s.logo != blank -%}
      <div class="objet-hero__logo">
        {{
          s.logo
          | image_url: width: 600
          | image_tag: widths: '150, 300, 450, 600', class: 'objet-hero__logo-img', alt: shop.name
        }}
      </div>
    {%- elsif s.logo_text != blank -%}
      <div class="objet-hero__logo objet-hero__logo--text">{{ s.logo_text }}</div>
    {%- endif -%}

    <div
      class="
        objet-hero__content-wrapper
        section-content-wrapper
        layout-panel-flex
        layout-panel-flex--column
        {% if s.vertical_on_mobile %}mobile-column{% endif %}
        {{ s.section_width }}
      "
      style="{% render 'layout-panel-style', settings: s %}"
    >
      {% content_for 'blocks' %}
    </div>
  </div>
</div>

{% stylesheet %}
  .objet-hero {
    position: relative;
    min-height: var(--objet-min-height, 100svh);
  }

  .objet-hero[data-shopify-visual-preview] {
    min-height: 600px;
  }

  .objet-hero__container {
    position: relative;
    display: grid;
    overflow: hidden;
    min-height: inherit;
  }

  .objet-hero__media-grid,
  .objet-hero__content-wrapper {
    grid-area: 1 / 1;
  }

  .objet-hero__media-grid {
    position: relative;
    z-index: var(--layer-base, 0);
  }

  .objet-hero__media,
  .objet-hero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .objet-hero__img--placeholder {
    background: #e9e6df;
  }

  .objet-hero__logo {
    position: absolute;
    top: 28px;
    left: 0;
    right: 0;
    z-index: var(--layer-raised, 3);
    display: flex;
    justify-content: center;
    pointer-events: none;
  }

  .objet-hero__logo-img {
    width: auto;
    max-width: 160px;
    height: auto;
  }

  .objet-hero__logo--text {
    font-family: var(--font-primary--family, inherit);
    font-size: 2.4rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    line-height: 1;
    color: rgb(var(--color-foreground));
  }

  .objet-hero__content-wrapper {
    position: relative;
    z-index: var(--layer-flat, 1);
  }

  /* Let interactive block content receive clicks while the wrapper itself doesn't block the image. */
  .objet-hero__content-wrapper {
    pointer-events: none;
  }

  .objet-hero__content-wrapper :is(a, button, input, textarea, select, label, details, summary) {
    pointer-events: auto;
  }

  @media screen and (min-width: 750px) {
    .objet-hero__logo-img {
      max-width: 200px;
    }

    .objet-hero__logo--text {
      font-size: 2.8rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Objet Charger Hero",
  "tag": "section",
  "class": "objet-charger-hero-section section-wrapper",
  "blocks": [
    {
      "type": "@theme"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile background image",
      "info": "Optional. Falls back to the desktop image."
    },
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image",
      "info": "Pinned to the top center. If empty, the logo text below is used."
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo text",
      "default": "orna"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Content width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "page-width"
    },
    {
      "type": "select",
      "id": "section_height",
      "label": "Section height",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "full-screen", "label": "Full screen" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "full-screen"
    },
    {
      "type": "range",
      "id": "section_height_custom",
      "label": "Custom height",
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "svh",
      "default": 80,
      "visible_if": "{{ section.settings.section_height == 'custom' }}"
    },
    {
      "type": "select",
      "id": "content_direction",
      "label": "Content direction",
      "options": [
        { "value": "column", "label": "Vertical" },
        { "value": "row", "label": "Horizontal" }
      ],
      "default": "column"
    },
    {
      "type": "checkbox",
      "id": "vertical_on_mobile",
      "label": "Stack content on mobile",
      "default": true
    },
    {
      "type": "select",
      "id": "horizontal_alignment_flex_direction_column",
      "label": "Horizontal alignment",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" }
      ],
      "default": "center",
      "visible_if": "{{ section.settings.content_direction != 'row' }}"
    },
    {
      "type": "select",
      "id": "vertical_alignment_flex_direction_column",
      "label": "Vertical position",
      "options": [
        { "value": "flex-start", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Bottom" },
        { "value": "space-between", "label": "Space between" }
      ],
      "default": "flex-end",
      "visible_if": "{{ section.settings.content_direction == 'column' }}"
    },
    {
      "type": "select",
      "id": "horizontal_alignment",
      "label": "Horizontal alignment",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" },
        { "value": "space-between", "label": "Space between" }
      ],
      "default": "center",
      "visible_if": "{{ section.settings.content_direction == 'row' }}"
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "Vertical position",
      "options": [
        { "value": "flex-start", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Bottom" }
      ],
      "default": "flex-end",
      "visible_if": "{{ section.settings.content_direction == 'row' }}"
    },
    {
      "type": "checkbox",
      "id": "align_baseline",
      "label": "Align baseline",
      "default": false,
      "visible_if": "{{ section.settings.vertical_alignment == 'flex-end' }}"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "toggle_overlay",
      "label": "Show overlay",
      "default": true
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "alpha": true,
      "default": "#00000080",
      "visible_if": "{{ section.settings.toggle_overlay }}"
    },
    {
      "type": "select",
      "id": "overlay_style",
      "label": "Overlay style",
      "options": [
        { "value": "solid", "label": "Solid" },
        { "value": "gradient", "label": "Gradient" }
      ],
      "default": "gradient",
      "visible_if": "{{ section.settings.toggle_overlay }}"
    },
    {
      "type": "select",
      "id": "gradient_direction",
      "label": "Gradient direction",
      "options": [
        { "value": "to top", "label": "Up" },
        { "value": "to bottom", "label": "Down" }
      ],
      "default": "to top",
      "visible_if": "{{ section.settings.toggle_overlay and section.settings.overlay_style == 'gradient' }}"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Objet Charger Hero",
      "category": "Banners",
      "settings": {
        "section_height": "full-screen",
        "color_scheme": "scheme-5",
        "vertical_alignment_flex_direction_column": "flex-end",
        "horizontal_alignment_flex_direction_column": "center",
        "gap": 8,
        "toggle_overlay": true,
        "overlay_style": "gradient",
        "gradient_direction": "to top"
      },
      "blocks": {
        "eyebrow": {
          "type": "text",
          "settings": {
            "text": "<p>Meet</p>",
            "alignment": "center",
            "type_preset": "h4",
            "width": "fit-content"
          }
        },
        "heading": {
          "type": "text",
          "settings": {
            "text": "<p>Objet Charger</p>",
            "alignment": "center",
            "type_preset": "h1",
            "width": "fit-content"
          }
        },
        "email": {
          "type": "email-signup",
          "settings": {
            "border_style": "all",
            "border_radius": 10,
            "integrated_button": true,
            "display_type": "text",
            "label": "GET 30% OFF"
          }
        },
        "price": {
          "type": "text",
          "settings": {
            "text": "<p><strong>From $70 for Early Birds</strong></p>",
            "alignment": "center",
            "type_preset": "h5",
            "width": "fit-content"
          }
        },
        "date": {
          "type": "text",
          "settings": {
            "text": "<p>August 2nd, 2026</p>",
            "alignment": "center",
            "type_preset": "rte",
            "width": "fit-content"
          }
        }
      },
      "block_order": ["eyebrow", "heading", "email", "price", "date"]
    }
  ]
}
{% endschema %}
