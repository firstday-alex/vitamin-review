{%- comment -%}
  Article Editor's Pick

  A product highlight carousel for the article rail. It marks itself with
  data-article-rail-item, which assets/article-toc.js looks for and adopts into
  the rail, so this module always sits directly below the "In this article"
  panel — in the desktop gutter and in the mobile stack alike.

  Two treatments, matching the two reference designs and switched purely on the
  rail's own layout mode:
    rail   — filled card, heading above, tall image, arrows either side
    inline — outlined card with the label notched into the border, image beside
             the copy

  With no TOC section on the page nothing adopts it and it renders in place as
  an ordinary section, so it degrades cleanly.

  Prices come from the product's own price and compare-at price. The suffix
  ("/month") is a setting, since a subscription price is a merchandising
  decision rather than something derivable from the variant.

  Each card links to the product's destination_url metafield when one is set,
  and to the product page otherwise. Create the definition in Shopify admin under
  Settings > Custom data > Products, namespace and key `custom.destination_url`.
  Link, URL and single-line-text types all work: Link stores an object and the
  other two a plain string, and both shapes are read below. The namespace and key
  are settings if yours differ.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign products = s.products

  assign dest_namespace = s.destination_namespace | default: 'custom'
  assign dest_key = s.destination_key | default: 'destination_url'
  assign dest_path = dest_namespace | append: '.' | append: dest_key
-%}

{%- if products.size > 0 -%}
  <script src="{{ 'editors-pick.js' | asset_url }}" type="module" fetchpriority="low"></script>

  <editors-pick
    class="epick"
    data-article-rail-item
    data-rail-order="{{ s.rail_order }}"
    data-loop="{% if s.loop %}true{% else %}false{% endif %}"
    data-controls="false"
    {%- if s.debug_links %}
      data-dbg-path="{{ dest_path | escape }}"
    {%- endif %}
    style="
      --epick-card-bg: {{ s.card_background }};
      --epick-border: {{ s.border_color }};
      --epick-label: {{ s.label_color }};
      --epick-vendor: {{ s.vendor_color }};
      --epick-title: {{ s.title_color }};
      --epick-pill-bg: {{ s.pill_background }};
      --epick-pill-text: {{ s.pill_text_color }};
      --epick-badge-bg: {{ s.badge_background }};
      --epick-badge-text: {{ s.badge_text_color }};
      --epick-radius: {{ s.corner_radius }}px;
      --epick-label-size: {{ s.label_size }}px;
      --epick-title-size: {{ s.title_size }}px;
    "
    {{ section.shopify_attributes }}
  >
    <div class="epick__frame">
      {%- if s.heading != blank -%}
        <p class="epick__label">{{ s.heading | escape }}</p>
      {%- endif -%}

      <div class="epick__stage">
        <div class="epick__viewport" data-epick-viewport>
          <ul class="epick__track">
            {%- for product in products -%}
              {%- liquid
                assign variant = product.selected_or_first_available_variant
                assign one_time_price = variant.price | default: product.price_min

                assign price = one_time_price
                assign compare = variant.compare_at_price | default: product.compare_at_price_max | default: 0
                assign is_subscription = false
                assign brand_name = s.brand_text | default: product.vendor

                # Prefer the subscription price when the product sells on a plan:
                # that is the "$23.40/month" figure, with the one-time price as the
                # struck-through "was". Reading variant.price alone showed the full
                # price with a /month suffix, which misstates it.
                if s.use_subscription_price
                  assign plan_price = 0
                  assign plan_compare = 0

                  for allocation in variant.selling_plan_allocations
                    if plan_price == 0 or allocation.price < plan_price
                      assign plan_price = allocation.price
                      assign plan_compare = allocation.compare_at_price | default: 0
                    endif
                  endfor

                  # Only adopt it if it actually beats buying once, so a plan that
                  # isn't a saving can't invent a discount.
                  if plan_price > 0 and plan_price < one_time_price
                    assign price = plan_price
                    assign is_subscription = true

                    if plan_compare > plan_price
                      assign compare = plan_compare
                    else
                      assign compare = one_time_price
                    endif
                  endif
                endif

                assign has_discount = false
                if compare > price and price > 0
                  assign has_discount = true
                  assign saved = compare | minus: price | times: 100.0 | divided_by: compare | round
                endif

                # Send the card to the product's destination_url metafield when it
                # has one, falling back to the product page.
                #
                # Only an explicit http(s):// URL or a path rooted at this domain is
                # accepted. That rules out javascript:/data: values, and also
                # protocol-relative "//host" ones, which look like a local path but
                # leave the site — an off-site link has to say https:// out loud.
                assign link_url = product.url
                assign dest_field = product.metafields[dest_namespace][dest_key]

                # Belt and braces: if the dynamic namespace/key lookup above comes
                # back empty while the settings still point at the default field,
                # read it by its literal path too. Costs nothing and removes the
                # lookup itself as a suspect when a value is set but not showing.
                if dest_field == blank and dest_namespace == 'custom' and dest_key == 'destination_url'
                  assign dest_field = product.metafields.custom.destination_url
                endif

                # Shopify's "Link" metafield type stores an object ({ url, text }),
                # while URL and text types store a plain string. Reading .value.url
                # first covers Link and falls through to the string for the others,
                # so any of the three works without a type check.
                assign destination = dest_field.value.url | default: dest_field.value | strip
                assign dest_ok = false

                if destination != blank
                  assign dest_http = destination | slice: 0, 7
                  assign dest_https = destination | slice: 0, 8

                  if dest_http == 'http://' or dest_https == 'https://'
                    assign dest_ok = true
                  else
                    assign dest_first = destination | slice: 0, 1
                    assign dest_two = destination | slice: 0, 2

                    if dest_first == '/' and dest_two != '//'
                      assign dest_ok = true
                    endif
                  endif

                  if dest_ok
                    assign link_url = destination
                  endif
                endif

              -%}
              <li
                class="epick__slide"
                data-epick-slide
                {%- if s.debug_links %}
                  data-dbg-title="{{ product.title | escape }}"
                  data-dbg-handle="{{ product.handle | escape }}"
                  data-dbg-exists="{% if dest_field != blank %}true{% else %}false{% endif %}"
                  data-dbg-type="{{ dest_field.type | default: '' | escape }}"
                  data-dbg-raw="{{ destination | escape }}"
                  data-dbg-linktext="{{ dest_field.value.text | default: '' | escape }}"
                  data-dbg-ok="{% if dest_ok %}true{% else %}false{% endif %}"
                  data-dbg-href="{{ link_url | escape }}"
                {%- endif %}
              >
                <a class="epick__link" href="{{ link_url }}">
                  <div class="epick__media">
                    {%- if product.featured_image -%}
                      {{
                        product.featured_image
                        | image_url: width: 800
                        | image_tag:
                          widths: '200, 300, 400, 600, 800',
                          sizes: '(max-width: 749px) 40vw, 260px',
                          class: 'epick__image',
                          loading: 'lazy',
                          alt: product.featured_image.alt | default: product.title
                      }}
                    {%- else -%}
                      {{ 'product-1' | placeholder_svg_tag: 'epick__image epick__image--placeholder' }}
                    {%- endif -%}

                    {%- if has_discount and s.show_badge -%}
                      <span class="epick__badge">{{ saved }}%<br>{{ s.badge_suffix | escape }}</span>
                    {%- endif -%}
                  </div>

                  <div class="epick__info">
                    {%- if s.show_vendor and brand_name != blank -%}
                      <span class="epick__vendor">{{ brand_name | escape }}</span>
                    {%- endif -%}
                    <span class="epick__title">{{ product.title | escape }}</span>
                  </div>

                  <span class="epick__pill">
                    <span class="epick__price">
                      {{- price | money -}}
                      {%- if s.price_suffix != blank and is_subscription -%}
                        {{- s.price_suffix | escape -}}
                      {%- endif -%}
                    </span>
                    {%- if has_discount -%}
                      <s class="epick__was">{{ compare | money }}</s>
                    {%- endif -%}
                  </span>
                </a>
              </li>
            {%- endfor -%}
          </ul>
        </div>

        <button
          class="epick__arrow epick__arrow--prev"
          type="button"
          data-epick-arrow="prev"
          aria-label="{{ 'accessibility.slideshow_previous' | t }}"
        >
          <svg viewBox="0 0 10 16" fill="none" aria-hidden="true" focusable="false">
            <path d="M8 1L2 8l6 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>

        <button
          class="epick__arrow epick__arrow--next"
          type="button"
          data-epick-arrow="next"
          aria-label="{{ 'accessibility.slideshow_next' | t }}"
        >
          <svg viewBox="0 0 10 16" fill="none" aria-hidden="true" focusable="false">
            <path d="M2 1l6 7-6 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>

      <div class="epick__dots" data-epick-dots></div>
    </div>
  </editors-pick>

  {%- comment -%}
    Diagnostic only, off unless "Log link lookup to the console" is enabled.
    Reports whether the metafield was found at all, its type, the raw value, and
    whether the URL guard accepted it — enough to tell "no metafield" apart from
    "metafield present but empty" and "value rejected".
  {%- endcomment -%}
  {%- if s.debug_links -%}
    <script>
      (function () {
        // No Liquid values are interpolated into this script. Everything is read
        // back out of HTML attributes, where escaping is unambiguous, so a URL
        // holding a closing script tag cannot break out of this one.
        document.querySelectorAll('editors-pick[data-dbg-path]').forEach(function (root) {
          var label = "[Editor's Pick] " + root.getAttribute('data-dbg-path');

          var rows = Array.prototype.map.call(root.querySelectorAll('[data-dbg-raw]'), function (el) {
            return {
              product: el.getAttribute('data-dbg-title'),
              handle: el.getAttribute('data-dbg-handle'),
              metafieldExists: el.getAttribute('data-dbg-exists') === 'true',
              type: el.getAttribute('data-dbg-type'),
              rawValue: el.getAttribute('data-dbg-raw'),
              linkText: el.getAttribute('data-dbg-linktext'),
              acceptedByGuard: el.getAttribute('data-dbg-ok') === 'true',
              finalHref: el.getAttribute('data-dbg-href')
            };
          });

          if (console.table) {
            console.groupCollapsed(label + ' \u2014 link lookup for ' + rows.length + ' product(s)');
            console.table(rows);
            console.groupEnd();
          } else {
            console.log(label, rows);
          }

          rows.forEach(function (row) {
            if (!row.metafieldExists) {
              console.warn(label + ': NOT FOUND on "' + row.product + '" (' + row.handle + '). Check the metafield exists on this product and is visible to the storefront.');
            } else if (!row.rawValue) {
              console.warn(label + ': found but EMPTY on "' + row.product + '" (' + row.handle + ').');
            } else if (!row.acceptedByGuard) {
              console.warn(label + ': value REJECTED on "' + row.product + '" \u2014 must start with https://, http:// or / \u2014 got: ' + row.rawValue);
            } else {
              console.info(label + ': OK on "' + row.product + '" -> ' + row.finalHref);
            }
          });
        });
      })();
    </script>
  {%- endif -%}
{%- endif -%}

{% stylesheet %}
  .epick {
    display: block;
    font-family: 'sofia-pro', sans-serif;
  }

  .epick__frame {
    position: relative;
  }

  .epick__label {
    margin: 0;
    color: var(--epick-label, #3b1e6b);
    font-size: var(--epick-label-size, 20px);
    font-weight: 700;
    line-height: 1.2;
  }

  .epick__stage {
    position: relative;
  }

  .epick__viewport {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }

  .epick__viewport::-webkit-scrollbar {
    display: none;
  }

  .epick__track {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .epick__slide {
    flex: 0 0 100%;
    margin: 0;
    list-style: none;
    scroll-snap-align: start;
  }

  .epick__link {
    display: grid;
    color: inherit;
    text-decoration: none;
  }

  .epick__media {
    position: relative;
  }

  .epick__image {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: calc(var(--epick-radius, 16px) * 0.75);
    object-fit: cover;
  }

  .epick__image--placeholder {
    background: rgb(0 0 0 / 4%);
    fill: rgb(0 0 0 / 12%);
  }

  .epick__badge {
    position: absolute;
    display: grid;
    place-content: center;
    border-radius: 50%;
    background: var(--epick-badge-bg, #486ced);
    color: var(--epick-badge-text, #ffffff);
    font-weight: 700;
    line-height: 1.05;
    text-align: center;
  }

  .epick__info {
    display: flex;
    flex-direction: column;
  }

  .epick__vendor {
    color: var(--epick-vendor, #4b3b7a);
    font-size: 0.8125rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .epick__title {
    color: var(--epick-title, #3b1e6b);
    font-size: var(--epick-title-size, 20px);
    font-weight: 700;
    line-height: 1.2;
    text-wrap: pretty;
  }

  .epick__pill {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding-block: 0.7em;
    padding-inline: 1.1em;
    border-radius: 999px;
    background: var(--epick-pill-bg, #3b1e5f);
    color: var(--epick-pill-text, #ffffff);
    font-size: 1rem;
    line-height: 1.2;
    text-align: center;
  }

  .epick__price {
    font-weight: 500;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .epick__was {
    opacity: 0.65;
    text-decoration: line-through;
  }

  .epick__link:hover .epick__title {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  /* --- Controls ----------------------------------------------------------- */
  .epick[data-controls='false'] :is(.epick__arrow, .epick__dots) {
    display: none;
  }

  .epick__arrow {
    position: absolute;
    top: 50%;
    display: grid;
    place-content: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: #ffffff;
    box-shadow: 0 4px 14px rgb(0 0 0 / 12%);
    color: var(--epick-title, #3b1e6b);
    cursor: pointer;
    transform: translateY(-50%);
    transition: opacity var(--animation-speed, 200ms) var(--animation-easing, ease);
  }

  .epick__arrow svg {
    width: 10px;
    height: 16px;
  }

  .epick__arrow:disabled {
    cursor: default;
    opacity: 0.35;
  }

  .epick__arrow--prev {
    left: 0;
  }

  .epick__arrow--next {
    right: 0;
  }

  .epick__dots {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  .epick__dot {
    width: 9px;
    height: 9px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--epick-border, #cfd8ec);
    cursor: pointer;
    transition: background-color var(--animation-speed, 200ms) var(--animation-easing, ease);
  }

  .epick__dot--active {
    background: var(--epick-pill-bg, #3b1e5f);
  }

  /* --- Treatment A: filled card, stacked. The desktop rail design. --------- */
  .article-toc[data-mode='rail'] .epick__frame {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: 24px 20px;
    border-radius: var(--epick-radius, 16px);
    background: var(--epick-card-bg, #e6eefb);
    text-align: center;
  }

  .article-toc[data-mode='rail'] .epick__link {
    gap: 16px;
    justify-items: center;
  }

  .article-toc[data-mode='rail'] .epick__image {
    aspect-ratio: 1;
  }

  /* The arrows straddle the image, as in the design. */
  .article-toc[data-mode='rail'] .epick__arrow {
    top: 6.5rem;
  }

  .article-toc[data-mode='rail'] .epick__arrow--prev {
    left: -14px;
  }

  .article-toc[data-mode='rail'] .epick__arrow--next {
    right: -14px;
  }

  .article-toc[data-mode='rail'] .epick__viewport {
    margin-inline: 14px;
  }

  .article-toc[data-mode='rail'] .epick__badge {
    top: 8px;
    right: 8px;
    width: 62px;
    height: 62px;
    font-size: 0.9375rem;
  }

  .article-toc[data-mode='rail'] .epick__pill {
    width: 100%;
  }

  /* --- Treatment B: outlined card with a notched label. The mobile design. - */
  .article-toc[data-mode='inline'] .epick__frame {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 20px;
    border: 1.5px solid var(--epick-border, #cfd8ec);
    border-radius: var(--epick-radius, 16px);
  }

  /* Notches the label into the top border rather than using a <fieldset>, so the
     card keeps its own semantics. */
  .article-toc[data-mode='inline'] .epick__label {
    position: absolute;
    top: 0;
    left: 20px;
    padding-inline: 8px;
    background: var(--epick-notch-bg, #ffffff);
    font-size: calc(var(--epick-label-size, 20px) * 0.85);
    transform: translateY(-50%);
  }

  .article-toc[data-mode='inline'] .epick__link {
    grid-template-columns: minmax(0, 96px) minmax(0, 1fr);
    gap: 8px 16px;
    align-items: center;
  }

  .article-toc[data-mode='inline'] .epick__image {
    aspect-ratio: 1;
  }

  .article-toc[data-mode='inline'] .epick__pill {
    grid-column: 1 / -1;
    width: 100%;
  }

  .article-toc[data-mode='inline'] .epick__badge {
    top: -6px;
    right: -6px;
    width: 46px;
    height: 46px;
    font-size: 0.75rem;
  }

  .article-toc[data-mode='inline'] .epick__arrow {
    /* Arrows would sit on top of the copy at this size; dots are enough. */
    display: none;
  }

  /* Standalone: no TOC adopted it, so give it the outlined treatment too. */
  .epick:not(.article-toc *) .epick__frame {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: var(--normal-content-width);
    margin-inline: auto;
    padding: 20px;
    border: 1.5px solid var(--epick-border, #cfd8ec);
    border-radius: var(--epick-radius, 16px);
  }

  .epick:not(.article-toc *) .epick__link {
    grid-template-columns: minmax(0, 120px) minmax(0, 1fr);
    gap: 8px 16px;
    align-items: center;
  }

  .epick:not(.article-toc *) .epick__pill {
    grid-column: 1 / -1;
  }

  .epick:not(.article-toc *) .epick__badge {
    top: -6px;
    right: -6px;
    width: 48px;
    height: 48px;
    font-size: 0.8125rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Article editor's pick",
  "tag": "aside",
  "class": "section-editors-pick",
  "settings": [
    {
      "type": "paragraph",
      "content": "Sits directly below the \"In this article\" panel — in the gutter on desktop, and above the article body on mobile. Hidden when no products are chosen."
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Products",
      "limit": 6,
      "info": "Shown as a carousel when more than one is chosen."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Label",
      "default": "Editor's Pick"
    },
    {
      "type": "select",
      "id": "rail_order",
      "label": "Position",
      "info": "Relative to the table of contents.",
      "options": [
        {
          "value": "after",
          "label": "Below the table of contents"
        },
        {
          "value": "before",
          "label": "Above the table of contents"
        }
      ],
      "default": "after"
    },
    {
      "type": "header",
      "content": "Link destination"
    },
    {
      "type": "paragraph",
      "content": "Cards link to each product's destination_url metafield when it is set, and to the product page when it isn't. Create it under Settings > Custom data > Products \u2014 Link, URL or single line text all work."
    },
    {
      "type": "text",
      "id": "destination_namespace",
      "label": "Metafield namespace",
      "default": "custom"
    },
    {
      "type": "text",
      "id": "destination_key",
      "label": "Metafield key",
      "default": "destination_url"
    },
    {
      "type": "checkbox",
      "id": "debug_links",
      "label": "Log link lookup to the console",
      "info": "Prints what each product's destination metafield resolved to. Turn off once you're done checking.",
      "default": false
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show brand name",
      "default": true
    },
    {
      "type": "text",
      "id": "brand_text",
      "label": "Brand name",
      "info": "Shown above the product title. Leave blank to use each product's vendor.",
      "default": "First Day"
    },
    {
      "type": "checkbox",
      "id": "use_subscription_price",
      "label": "Show the subscription price",
      "info": "Uses the product's cheapest selling plan price, with the one-time price struck through. Falls back to the one-time price when the product has no plan.",
      "default": true
    },
    {
      "type": "text",
      "id": "price_suffix",
      "label": "Price suffix",
      "info": "Appended only to subscription prices, e.g. \"/month\". Leave blank for none.",
      "default": "/month"
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show discount badge",
      "info": "Appears only when the product has a compare-at price.",
      "default": true
    },
    {
      "type": "text",
      "id": "badge_suffix",
      "label": "Badge wording",
      "default": "OFF"
    },
    {
      "type": "checkbox",
      "id": "loop",
      "label": "Loop the carousel",
      "default": false
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background (desktop rail)",
      "default": "#E6EEFB"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border and inactive dots",
      "default": "#CFD8EC"
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Label",
      "default": "#3B1E6B"
    },
    {
      "type": "color",
      "id": "vendor_color",
      "label": "Brand name",
      "default": "#4B3B7A"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Product title",
      "default": "#3B1E6B"
    },
    {
      "type": "color",
      "id": "pill_background",
      "label": "Price pill background",
      "default": "#3B1E5F"
    },
    {
