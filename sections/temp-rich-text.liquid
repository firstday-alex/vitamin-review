{%- style -%}
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-right: {{ section.settings.padding_right | default: 0 }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --section-padding-left: {{ section.settings.padding_left | default: 0 }}px;
    --section-padding-right-m: {{ section.settings.padding_right_mobile | default: 0 }}px;
    --section-padding-left-m: {{ section.settings.padding_left_mobile | default: 0 }}px;
    --rt-accent-color: {{ section.settings.colors_accent_text | default: '#486CED' }};
    {%- if section.settings.use_custom_colors %}
      --gradient-background: {% if section.settings.gradient_background != blank %}{{ section.settings.gradient_background }}{% else %}{{ section.settings.colors_background }}{% endif %};
      --color-background: {{ section.settings.colors_background.red }}, {{ section.settings.colors_background.green }}, {{ section.settings.colors_background.blue }};
      --color-foreground: {{ section.settings.colors_text.red }}, {{ section.settings.colors_text.green }}, {{ section.settings.colors_text.blue }};
      --color-link: var(--color-foreground);
      --color-border: var(--color-foreground);
      --color-heading: var(--color-foreground);
      --color-button-background: {{ section.settings.colors_button_background.red }}, {{ section.settings.colors_button_background.green }}, {{ section.settings.colors_button_background.blue }};
      --color-button-text: {{ section.settings.colors_button_label.red }}, {{ section.settings.colors_button_label.green }}, {{ section.settings.colors_button_label.blue }};
      --color-button-border: var(--color-button-background);
    {% endif -%}
  }

  #shopify-section-{{ section.id }} .rich-text__image-block {
    text-align: var(--rt-image-align, left);
    margin: var(--rt-image-margin-top, 0px) var(--rt-image-margin-right, 0px) var(--rt-image-margin-bottom, 0px) var(--rt-image-margin-left, 0px);
  }

  #shopify-section-{{ section.id }} .rich-text__image-block img {
    width: var(--rt-image-width, auto);
    max-width: var(--rt-image-max-width, 100%);
    height: auto;
    display: inline-block;
  }

  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .rich-text__image-block {
      text-align: var(--rt-image-align-mobile, left);
      margin: var(--rt-image-margin-top-mobile, 0px) var(--rt-image-margin-right-mobile, 0px) var(--rt-image-margin-bottom-mobile, 0px) var(--rt-image-margin-left-mobile, 0px);
    }

    #shopify-section-{{ section.id }} .rich-text__image-block img {
      width: var(--rt-image-width-mobile, auto);
      max-width: var(--rt-image-max-width-mobile, 100%);
    }

    #shopify-section-{{ section.id }} .rich-text {
      padding-left: var(--section-padding-left-m) !important;
      padding-right: var(--section-padding-right-m) !important;
    }
  }
{%- endstyle -%}

<style>
  .rt-accent { color: var(--rt-accent-color, #486CED); }

  {%- if section.settings.bg_image_desktop != blank -%}
    #shopify-section-{{ section.id }} .rich-text {
      background-image: url('{{ section.settings.bg_image_desktop | image_url: width: 2400 }}');
      background-size: {{ section.settings.bg_image_size | default: 'cover' }};
      background-position: {{ section.settings.bg_image_position | default: 'center center' }};
      background-repeat: no-repeat;
    }
  {%- endif -%}

  {%- if section.settings.bg_image_mobile != blank -%}
    @media (max-width: 749px) {
      #shopify-section-{{ section.id }} .rich-text {
        background-image: url('{{ section.settings.bg_image_mobile | image_url: width: 1200 }}');
        background-size: {{ section.settings.bg_image_size_mobile | default: 'cover' }};
        background-position: {{ section.settings.bg_image_position_mobile | default: 'center center' }};
        background-repeat: no-repeat;
      }
    }
  {%- endif -%}
</style>

{% comment %} {{ 'section-rich-text.css' | asset_url | stylesheet_tag }} {% endcomment %}
{% render 'section-rich-text.css'  %}
{% render 'component-rte.css'  %}


{%- liquid
  assign custom_class = ''
  if section.settings.use_custom_colors
    assign custom_class = custom_class | append: ' rich-text--colored'
  endif
  if section.settings.horizontal_content
    assign custom_class = custom_class | append: ' rich-text--horizontal'
  endif
-%}

{%- if section.settings.show_divider %}<div class="section--divider">{% endif -%}
  {% if section.settings.top_waves %}
      {% render 'waves', wavePosition: 'top', color: section.settings.background_color, containerBackground: section.settings.wavesTopBackgroundColor  %}
  {% endif %}
  {% assign containerPaddingTop = '0' %}
  {% assign containerPaddingBottom = '0' %}
  {% if section.settings.top_waves %}
          {% assign containerPaddingTop = '40px' %}
  {% endif %}
  
  {% if section.settings.bottom_waves %}
      {% assign containerPaddingBottom = '40px' %}
  {% endif %}
  <div style="{% if section.settings.enable_background_color %}background-color: {{ section.settings.section_background_color }};{% endif %} padding-top: {{ containerPaddingTop }}; padding-bottom: {{ containerPaddingBottom }}">
    <div class="page-width{% if section.settings.narrow %} page-width--inner{% endif %}">

      <div class="rich-text section--padding{{ custom_class }}" style="{% if section.settings.enable_background_color %}background-color: {{ section.settings.section_background_color }};{% endif %} padding-left: var(--section-padding-left); padding-right: var(--section-padding-right);">
        <div class="rich-text__blocks {{ section.settings.text_alignment }} mobile-{{ section.settings.mobile_text_alignment }}">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'heading' -%}
                <{{ block.settings.heading_tag }} class="rich-text__heading {{ block.settings.heading_size }}" {% if block.settings.font_family != blank %}style="font-family: {{ block.settings.font_family }};"{% endif %} {{ block.shopify_attributes }}>{{ block.settings.heading | escape | replace: '[', '<span class="rt-accent">' | replace: ']', '</span>' }}</{{ block.settings.heading_tag }}>
              {%- when 'subheading' -%}
                <p class="rich-text__subheading{% if block.settings.secondary_color %} rich-text__subheading--colored{% endif %} {{ block.settings.subheading_size }}" {% if block.settings.font_family != blank %}style="font-family: {{ block.settings.font_family }};"{% endif %} {{ block.shopify_attributes }}>{{ block.settings.subheading | escape | replace: '[', '<span class="rt-accent">' | replace: ']', '</span>' }}</p>
              {%- when 'text' -%}
                <div class="rich-text__text{% if block.settings.secondary_color %} rich-text__text--colored{% endif %} {{ block.settings.text_size }} rte" {% if block.settings.font_family != blank %}style="font-family: {{ block.settings.font_family }};"{% endif %} {{ block.shopify_attributes }}>{{ block.settings.text | replace: '[', '<span class="rt-accent">' | replace: ']', '</span>' }}</div>
              {%- when 'custom_liquid' -%}
                <div class="rich-text__text rte" {% if block.settings.font_family != blank %}style="font-family: {{ block.settings.font_family }};"{% endif %} {{ block.shopify_attributes }}>{{ block.settings.custom_liquid }}</div>
              {%- when 'image' -%}
                {%- if block.settings.image != blank -%}
                  <div
                    class="rich-text__image-block"
                    style="
                      --rt-image-align: {{ block.settings.alignment }};
                      --rt-image-align-mobile: {{ block.settings.alignment_mobile }};
                      --rt-image-width: {{ block.settings.width_desktop }};
                      --rt-image-max-width: {{ block.settings.max_width_desktop }};
                      --rt-image-width-mobile: {{ block.settings.width_mobile }};
                      --rt-image-max-width-mobile: {{ block.settings.max_width_mobile }};
                      --rt-image-margin-top: {{ block.settings.margin_top_desktop }}px;
                      --rt-image-margin-right: {{ block.settings.margin_right_desktop }}px;
                      --rt-image-margin-bottom: {{ block.settings.margin_bottom_desktop }}px;
                      --rt-image-margin-left: {{ block.settings.margin_left_desktop }}px;
                      --rt-image-margin-top-mobile: {{ block.settings.margin_top_mobile }}px;
                      --rt-image-margin-right-mobile: {{ block.settings.margin_right_mobile }}px;
                      --rt-image-margin-bottom-mobile: {{ block.settings.margin_bottom_mobile }}px;
                      --rt-image-margin-left-mobile: {{ block.settings.margin_left_mobile }}px;
                    "
                    {{ block.shopify_attributes }}
                  >
                    {{ block.settings.image | image_url: width: 2000 | image_tag: loading: 'lazy' }}
                  </div>
                {%- endif -%}
              {%- when 'button' -%}
                {%- if block.settings.button_label != blank -%}
                  {%- if block.settings.button_style_secondary -%}
                    <a class="button button--cta button--{{ block.settings.button_size }}"{% if block.settings.button_link != blank %} href="{{ block.settings.button_link }}"{% else %} role="link" aria-disabled="true"{% endif %} {% if block.settings.font_family != blank %}style="font-family: {{ block.settings.font_family }};"{% endif %} {{ block.shopify_attributes }}>
                      <span class="label">{{ block.settings.button_label | escape }}</span>
                      {% render 'icon', icon: 'arrow' %}
                    </a>
                  {%- else -%}
                    <a class="button button--{{ block.settings.button_size }}"{% if block.settings.button_link != blank %} href="{{ block.settings.button_link }}"{% else %} role="link" aria-disabled="true"{% endif %} {% if block.settings.font_family != blank %}style="font-family: {{ block.settings.font_family }};"{% endif %} {{ block.shopify_attributes }}>
                      {{ block.settings.button_label | escape }}
                    </a>
                  {%- endif -%}
                {%- endif -%}
            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
  {% if section.settings.bottom_waves %}
      {% render 'waves', wavePosition: 'bottom', color: section.settings.background_color, containerBackground: section.settings.wavesBottomBackgroundColor %}
  {% endif %}    
{%- if section.settings.show_divider %}</div>{% endif -%}

{% schema %}
{
  "name": "t:sections.rich-text.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "text_alignment",
      "options": [
        {
          "value": "left",
          "label": "t:sections.all.text_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.all.text_alignment.options__2.label"
        },
        {
          "value": "right",
          "label": "t:sections.all.text_alignment.options__3.label"
        }
      ],
      "default": "left",
      "label": "t:sections.all.text_alignment.label"
    },
    {
      "type": "select",
      "id": "mobile_text_alignment",
      "options": [
        {
          "value": "left",
          "label": "t:sections.all.mobile_layout.mobile_text_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.all.mobile_layout.mobile_text_alignment.options__2.label"
        },
        {
          "value": "right",
          "label": "t:sections.all.mobile_layout.mobile_text_alignment.options__3.label"
        }
      ],
      "default": "left",
      "label": "t:sections.all.mobile_layout.mobile_text_alignment.label"
    },
    {
      "type": "checkbox",
      "id": "horizontal_content",
      "default": false,
      "label": "t:sections.rich-text.settings.horizontal_content.label"
    },
    {
      "type": "checkbox",
      "id": "narrow",
      "default": false,
      "label": "t:sections.all.narrow.label"
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "default": false,
      "label": "t:sections.all.show_divider.label"
    },
    {
      "type": "header",
      "content": "Section Background"
    },  
    {
      "type": "checkbox",
      "id": "enable_background_color",
      "default": false,
      "label": "Enable section background color"
    },     
    {
      "type": "color",
      "id": "section_background_color",
      "label": "Section Background",
      "default": "#A8E8E2"
    },      
    {
      "type": "header",
      "content": "Waves"
    },    
    {
      "type": "color",
      "id": "background_color",
      "default": "#A8E8E2",
      "label": "Color of the wave"
    },
    {
      "type": "checkbox",
      "id": "top_waves",
      "default": false,
      "label": "Enable waves on top"
    },         
    {
      "type": "color",
      "id": "wavesTopBackgroundColor",
      "default": "#F2FBFE",
      "label": "Background color of the top wave"
    },
    {
      "type": "checkbox",
      "id": "bottom_waves",
      "default": false,
      "label": "Enable waves on bottom"
    },           
    {
      "type": "color",
      "id": "wavesBottomBackgroundColor",
      "default": "#F2FBFE",
      "label": "Background color of the bottom wave"
    },        
    {
      "type": "header",
      "content": "t:sections.all.colors.header.content"
    },
    {
      "type": "checkbox",
      "id": "use_custom_colors",
      "default": false,
      "label": "t:sections.all.colors.use_custom_colors.label"
    },
    {
      "type": "color",
      "id": "colors_button_label",
      "label": "t:sections.all.colors.colors_button_label.label",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "colors_button_background",
      "label": "t:sections.all.colors.colors_button_background.label",
      "default": "#1a1b18"
    },
    {
      "type": "color",
      "id": "colors_text",
      "label": "t:sections.all.colors.colors_text.label",
      "default": "#212326"
    },
    {
      "type": "color",
      "id": "colors_accent_text",
      "label": "Text Color Accent",
      "default": "#486CED"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.header.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
