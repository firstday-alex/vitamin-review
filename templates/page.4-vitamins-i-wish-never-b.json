        "custom_liquid_EVwitD": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<div class=\"author-card\">\n  <img src=\"https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&q=80&w=200&h=200\" alt=\"Sara Mitchell\" class=\"avatar\">\n  \n  <div class=\"author-info\">\n    <span class=\"author-name\"><span class=\"by-label\">By</span> Sara Mitchell</span>\n    <span class=\"meta-line\">Updated: March 15, 2026 — 5 min read</span>\n  </div>\n</div>\n\n<style>\n.author-card {\n  display: flex;\n  align-items: center;\n  font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;\n  gap: 12px;\n  max-width: 400px;\n  padding: 10px;\n}\n\n.avatar {\n  width: 48px;\n  height: 48px;\n  border-radius: 50%;\n  object-fit: cover;\n  flex-shrink: 0;\n}\n\n.author-info {\n  display: flex;\n  flex-direction: column;\n  line-height: 1.4;\n}\n\n.author-name {\n  font-size: 14px;\n  font-weight: 700;\n  color: #111;\n}\n\n.by-label {\n  font-weight: 400;\n}\n\n.meta-line {\n  font-size: 13px;\n  color: #666;\n  font-weight: 400;\n  margin-top: 2px;\n}\n</style>",
            "font_family": ""
